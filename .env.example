# Mirror configuration
# ---------------------------------------------------------------------------
# Quick switch: set MIRROR_PROFILE to select a pre-built mirror profile.
#   cn   — domestic sources (Aliyun, daocloud, goproxy.cn) — DEFAULT
#   intl — international sources (Docker Hub, PyPI, golang.org)
#
# With Makefile:
#   make up MIRROR_PROFILE=intl        (one-off)
#   MIRROR_PROFILE=intl  ← add to this file for persistent switch
#
# Without Makefile (docker compose directly):
#   docker compose --env-file .env.mirrors.intl up -d
#
# Individual variables below override the selected profile when uncommented.
# ---------------------------------------------------------------------------

#MIRROR_PROFILE=intl

# Docker Hub mirror prefix (trailing slash required)
# Domestic (default): docker.m.daocloud.io/library/
# International:      (empty string — pull directly from Docker Hub)
#DOCKER_MIRROR=

# PyPI mirror
# Domestic (default): https://mirrors.aliyun.com/pypi/simple
# International:      https://pypi.org/simple
#PIP_INDEX_URL=https://pypi.org/simple

# Go module proxy
# Domestic (default): https://goproxy.cn,direct
# International:      https://proxy.golang.org,direct
#GOPROXY=https://proxy.golang.org,direct

# APT mirror (used inside Python/Go Docker images based on Debian)
# Domestic (default): http://mirrors.aliyun.com/debian
# International:      http://deb.debian.org/debian
#APT_MIRROR=http://deb.debian.org/debian
#APT_SECURITY_MIRROR=http://security.debian.org

# pip timeout / retry tuning
#PIP_DEFAULT_TIMEOUT=300
#PIP_RETRIES=10

# Model configuration
# All algorithm services use LAZYMIND_MODEL_CONFIG_PATH. The default is dynamic,
# so per-user model/API-key selections from the frontend can be injected per request.
# Set online/inner only when forcing a static config.
# For a gitignored machine override, copy runtime_models.inner.yaml to
# runtime_models.local.yaml (or set LAZYMIND_MODEL_CONFIG_PATH=local).
# Selecting inner also prefers a sibling runtime_models.local.yaml when present.
#LAZYMIND_MODEL_CONFIG_PATH=dynamic
#LAZYMIND_EPISODE_RECENT_PROGRESS_INJECT_TOPK=3
#LAZYMIND_CHAT_UNLIKE_SWITCH=false
# Full storage has no item limit; Chat and Organizer share this character budget.
#LAZYMIND_PREFERENCE_CONTEXT_MAX_CHARS=5000
#LAZYLLM_QWEN_API_KEY=your-qwen-api-key

# Docker Compose creates a random internal service token on first startup and
# reuses it from the internal-service-credentials volume. No setup is required
# for local/BYO use. Only the services that need it mount the volume read-only.
# Optional overrides, in precedence order: existing direct token, then HOST file.
# Prefer the file form for new deployments; the direct variable remains supported.
#LAZYMIND_AUTH_SERVICE_INTERNAL_TOKEN=your-existing-internal-token
#LAZYMIND_INTERNAL_SERVICE_TOKEN_FILE=/absolute/path/to/internal-service-token
# Generate a file outside the repository if an explicit key is needed:
#   (umask 077; openssl rand -hex 32 > /absolute/path/to/internal-service-token)
# After changing an override, recreate all consumers to load the same token:
#   docker compose up -d --force-recreate
# Removing Docker volumes (down -v) also removes the generated internal token.

# Optional LazyMind Cloud. Leave the URL unset for local/BYO-only use.
# For Cloud sign-in, create a persistent 32-byte Base64 encryption key (mode 0600):
#   (umask 077; openssl rand -base64 32 > /absolute/path/to/cloud-token-store-key)
# Generate a stable installation ID once, e.g. ci_ followed by `openssl rand -hex 16`.
# Keep the ID and encryption key across restarts; do not share them across installs.
#LAZYMIND_CLOUD_BASE_URL=https://cloud.example.com
#LAZYMIND_CLIENT_INSTANCE_ID=ci_replace_with_a_random_instance_id
#LAZYMIND_CLOUD_TOKEN_STORE_KEY_FILE=/absolute/path/to/cloud-token-store-key
#LAZYMIND_CLOUD_SESSION_DIR=./data/core/cloud-session
# Host-loopback callback port; change if 18081 is already occupied.
#LAZYMIND_CLOUD_CALLBACK_PORT=18081

# Optional Cloud credential backup: configure ALL THREE existing public manifest
# files on the HOST. Compose mounts them read-only at fixed container paths.
# Desktop/Local use these same variables as direct host paths.
# Only the offline Ed25519 public key belongs here, never a Recovery private key.
#LAZYMIND_CREDENTIAL_MANIFEST_TRUST_PUBLIC_KEY_FILE=/absolute/path/to/credential-manifest-signing-public.der
#LAZYMIND_CREDENTIAL_MANIFEST_BOOTSTRAP_PAYLOAD_FILE=/absolute/path/to/credential-manifest.json
#LAZYMIND_CREDENTIAL_MANIFEST_BOOTSTRAP_SIGNATURE_FILE=/absolute/path/to/credential-manifest.sig

# Optional Feishu CLI sidecar, independent of base local/BYO services.
# Enable the profile AND provide its own random HMAC file (mode 0600):
#   (umask 077; openssl rand -hex 32 > /absolute/path/to/feishu-cli-sidecar-hmac)
# Use `docker compose --profile feishu-cli up -d`, or add feishu-cli to your
# existing COMPOSE_PROFILES. Core can start without this sidecar being healthy.
#COMPOSE_PROFILES=feishu-cli
#LAZYMIND_FEISHU_CLI_SIDECAR_HMAC_FILE=/absolute/path/to/feishu-cli-sidecar-hmac
#LAZYMIND_FEISHU_CLI_DATA_DIR=./data/provider-connections/feishu-cli
# The bundled URL is selected automatically when the HMAC file is set.
# Override only when using an external compatible sidecar; it needs the same key.
#LAZYMIND_FEISHU_CLI_SIDECAR_URL=http://feishu-cli-sidecar:19091

# ModuleCache (lazyllm ModuleBase): LAZYLLM_CACHE_STRATEGY / LAZYLLM_CACHE_MODE / LAZYLLM_CACHE_DIR
#LAZYLLM_CACHE_STRATEGY=file
#LAZYLLM_CACHE_MODE=RW
#LAZYLLM_CACHE_DIR=/var/lib/lazymind/uploads/.lazyllm_cache
#LAZYMIND_READER_USE_CACHE=true  # forwarded to LAZYLLM_READER_USE_CACHE (lazyllm.config reader_use_cache)

# MinerU online API SSL verify (default false because some mineru.net endpoints
# currently present a mismatched certificate). Re-enable after the upstream fix:
#LAZYLLM_MINERU_SSL_VERIFY=true
# Local runtime (LAZYMIND_RUNTIME_MODE=local) also skips automatically.

# File-watcher configuration
# ---------------------------------------------------------------------------
# LAZYMIND_FILE_WATCHER_BASE_ROOT: host directory used as the file-watcher
#   data root (PID file, logs, staging area). Default: ./data/scan
#LAZYMIND_FILE_WATCHER_BASE_ROOT=./data/scan

# LAZYMIND_FILE_WATCHER_WATCH_HOST_DIR: host directory the file-watcher
#   monitors for new documents. Auto-detected per OS:
#     macOS   → /Users
#     Linux   → /tmp
#     Windows → D:/
# Uncomment and set to override.
#LAZYMIND_FILE_WATCHER_WATCH_HOST_DIR=/home

# LAZYMIND_FILE_WATCHER_MODE: container (default) or host.
#   container — file-watcher runs as a Docker service (recommended)
#   host      — file-watcher runs as a host process (for local debugging)
#LAZYMIND_FILE_WATCHER_MODE=container

# Optional Obsidian host scan-root override. Without it, LazyMind scans the
# generic local file root. Set it only when the Vault is outside that root,
# then recreate the chat container.
# macOS/Linux: OBSIDIAN_HOST_ROOT=/Users/you/Documents
# Windows:     OBSIDIAN_HOST_ROOT=C:/Users/you/Documents

# Frontend feature flags
# ---------------------------------------------------------------------------
# VITE_HIDE_EVO: hide the Self-Evolution (Evo) page from the web UI.
#   Not set (default) — Evo page is visible
#   Set to any value   — Evo page is hidden
#VITE_HIDE_EVO=true

# LAZYMIND_VOCABULARY_ENABLED: build and expose the vocabulary/Anki feature.
#   false (Docker Compose default) — no frontend entry or Core routes
#   true  (LazyMind Desktop default) — enable vocabulary and local provider
#LAZYMIND_VOCABULARY_ENABLED=false
