   Pop $R0
   SetOutPath $R0
+  IfErrors AbortExtract7za 0
+  ${If} $LMLayoutMode == "new"
+    !insertmacro LMPublishFreshFiles
+    Goto DoneExtract7za
+  ${EndIf}
+  !insertmacro LMVerifyExtract "$LMStageRoot\7z-out"
 
