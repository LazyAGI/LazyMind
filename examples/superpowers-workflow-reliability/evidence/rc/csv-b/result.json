            "head": "a617bec1b428118e64754e18eb60e42cb1780ac9",
            "diff": "diff --git a/csv_records.py b/csv_records.py\nindex 557e92c..6346afc 100644\n--- a/csv_records.py\n+++ b/csv_records.py\n@@ -1,2 +1,25 @@\n-def read_records(text):\n-    raise NotImplementedError\n+import csv\n+import io\n+\n+\n+def read_records(text: str) -> list[dict[str, str]]:\n+    \"\"\"Read CSV records with trimmed, unique headers and consistent row widths.\"\"\"\n+    if not text.strip():\n+        return []\n+\n+    rows = csv.reader(io.StringIO(text, newline=\"\"))\n+    headers = [cell.strip() for cell in next(rows)]\n+    if not headers or any(not header for header in headers):\n+        raise ValueError(\"CSV headers must not be empty\")\n+    if len(set(headers)) != len(headers):\n+        raise ValueError(\"CSV headers must be unique\")\n+\n+    records = []\n+    for row in rows:\n+        if len(row) != len(headers):\n+            raise ValueError(\n+                f\"CSV row ending at line {rows.line_num} has {len(row)} cells; \"\n+                f\"expected {len(headers)}\"\n+            )\n+        records.append(dict(zip(headers, (cell.strip() for cell in row))))\n+    return records",
