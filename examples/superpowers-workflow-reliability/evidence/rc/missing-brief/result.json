            "diff": "diff --git a/csv_records.py b/csv_records.py\nindex 557e92c..59abcc7 100644\n--- a/csv_records.py\n+++ b/csv_records.py\n@@ -1,2 +1,25 @@\n-def read_records(text):\n-    raise NotImplementedError\n+import csv\n+import io\n+\n+\n+def read_records(text: str) -> list[dict[str, str]]:\n+    \"\"\"Read CSV records with normalized headers and trimmed cell values.\"\"\"\n+    if not text.strip():\n+        return []\n+\n+    reader = csv.reader(io.StringIO(text, newline=\"\"))\n+    headers = [header.strip() for header in next(reader)]\n+    if not headers or any(not header for header in headers):\n+        raise ValueError(\"CSV headers must not be empty\")\n+    if len(set(headers)) != len(headers):\n+        raise ValueError(\"CSV headers must be unique after trimming\")\n+\n+    records = []\n+    for row in reader:\n+        if len(row) != len(headers):\n+            raise ValueError(\n+                f\"CSV row ending at line {reader.line_num} has {len(row)} \"\n+                f\"cells; expected {len(headers)}\"\n+            )\n+        records.append(dict(zip(headers, (cell.strip() for cell in row))))\n+    return records",
