frontend.kind=host-process status=running
scan-control-plane.kind=host-process status=running
file-watcher.kind=host-process status=running
milvus-lite.kind=host-process status=running
lazyllm-parse-server.kind=host-process status=running
chat.kind=host-process status=running
process-supervisor.kind=host-supervisor status=running
channel-gateway.kind=host-process status=running
lazyllm-parse-worker.kind=host-process status=running
lazyllm-algo.kind=host-process status=running
